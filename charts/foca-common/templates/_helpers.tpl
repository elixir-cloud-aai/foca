{{- /*
Helpers of the library chart. Resource templates (in the other files) take a
context dict with the root context of the app chart (`root`) and the app's
settings (`settings`; see `foca-common.checkSettings`); helpers that do not
depend on the settings take the root context, or a dict with it (`root`).
*/ -}}

{{/*
Name of the chart, or `nameOverride`.
*/}}
{{- define "foca-common.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{/*
Name of the app's resources: the release name, followed by the chart name
unless the release name contains it, or `fullnameOverride`; truncated to 63
characters, as some names must be DNS labels.
*/}}
{{- define "foca-common.fullname" -}}
{{- if .Values.fullnameOverride -}}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- $name := include "foca-common.name" . -}}
{{- if contains $name .Release.Name -}}
{{- .Release.Name | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{/*
Name of the MongoDB resources and the host name of its Service; the app's
name is truncated first, so that the suffix is kept (`foca-common.validate`
rejects the one name that still collides).
*/}}
{{- define "foca-common.mongodbFullname" -}}
{{- printf "%s-mongodb" (include "foca-common.fullname" . | trunc 55 | trimSuffix "-") -}}
{{- end -}}

{{/*
Name of the Celery worker's Deployment; truncated like
`foca-common.mongodbFullname`.
*/}}
{{- define "foca-common.workerFullname" -}}
{{- printf "%s-worker" (include "foca-common.fullname" . | trunc 56 | trimSuffix "-") -}}
{{- end -}}

{{/*
Name of the resources of the bundled broker and the host name of its
Service; truncated like `foca-common.mongodbFullname`.
*/}}
{{- define "foca-common.brokerFullname" -}}
{{- printf "%s-broker" (include "foca-common.fullname" . | trunc 56 | trimSuffix "-") -}}
{{- end -}}

{{/*
Name of the HTTPRoute redirecting HTTP to HTTPS; truncated like
`foca-common.mongodbFullname`.
*/}}
{{- define "foca-common.httpsRedirectFullname" -}}
{{- printf "%s-https-redirect" (include "foca-common.fullname" . | trunc 48 | trimSuffix "-") -}}
{{- end -}}

{{/*
Labels that select the pods of a component; call with a dict of the root
context (`root`) and the component (`component`: `app`, `mongodb`, `worker`
or `broker`).
*/}}
{{- define "foca-common.selectorLabels" -}}
app.kubernetes.io/name: {{ include "foca-common.name" .root | quote }}
app.kubernetes.io/instance: {{ .root.Release.Name | quote }}
app.kubernetes.io/component: {{ .component | quote }}
{{- end -}}

{{/*
Labels of all resources of a component; call like
`foca-common.selectorLabels`.
*/}}
{{- define "foca-common.labels" -}}
helm.sh/chart: {{ printf "%s-%s" .root.Chart.Name .root.Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
{{ include "foca-common.selectorLabels" . }}
app.kubernetes.io/version: {{ .root.Chart.AppVersion | replace "+" "_" | trunc 63 | trimSuffix "-" | quote }}
app.kubernetes.io/managed-by: {{ .root.Release.Service }}
{{- end -}}

{{/*
Fails unless the settings of the app chart are valid; renders nothing. The
settings are a dict with the keys:

- `valuesKey` (required): key of the app's values (e.g., `cloudRegistry`), a
  map with the settings of its container (`image`, `tag`, `probePath`,
  `ingress`, `networkPolicy`, `podSecurityContext`, `securityContext`,
  `resources`, `tmpSizeLimit`, `preStopSleepSeconds`, `gunicorn`);
- `containerName`: name of the app's container, by default the chart name;
- `configDir`: directory where the config overlay is mounted (as
  `overlay.yaml`), by default `/etc/<chart name>`;
- `config`: config generated by the app chart (e.g., from `hostName`), merged
  into the overlay before the values' `config`;
- `maxContentLength`: size limit of request bodies of the app's base config
  (`server.max_content_length`), in bytes, if it has one (see
  `foca-common.maxContentLength`);
- `requireAudience`: whether rendering fails without an audience for tokens
  (`config.security.auth.audience`), as the app requires one;
- `requireAccessControl`: whether rendering fails without enforced access control and
  the settings it needs (see `foca-common.checkAccessControl`), as the app requires
  them;
- `plugins`: whether the values `plugins` are rendered into the overlay's section
  `plugins`, with keys in snake_case (see `foca-common.pluginsConfig`);
- `backendsKey`: top-level key of the values with the app's backends
  (`<backendsKey>.backends`), rendered into `custom.<backendsKey>.backends`, with keys
  in snake_case; also sets `server.public_url` from `publicUrl` or `hostName` (see
  `foca-common.gatewayConfig`);
- `mongodb.databases`: databases of the app's base config (`db.dbs`), the
  first of which FOCA authenticates against; required for the bundled
  MongoDB with authentication, which creates the app user;
- `mongodb.accessControlDatabase`: database of FOCA's access control
  (`security.access_control.db_name`), if the app's base config enables it;
  the app user of the bundled MongoDB gets access to it, too (see
  `foca-common.accessControlDatabase`).

The app's values must also contain the maps `mongodb` and `mongodb.auth`,
even for an external MongoDB (see the docs).
*/}}
{{- define "foca-common.checkSettings" -}}
{{- if not (kindIs "map" .settings) -}}
{{- fail "foca-common: templates must be called with a dict of the root context (root) and the app's settings (settings)" -}}
{{- end -}}
{{- if hasKey .settings "Error" -}}
{{- fail (printf "foca-common: the app's settings are not valid YAML: %s" .settings.Error) -}}
{{- end -}}
{{- $key := .settings.valuesKey -}}
{{- if not (and (kindIs "string" $key) $key) -}}
{{- fail "foca-common: the app's settings must set valuesKey, the key of the app's values" -}}
{{- end -}}
{{- if not (kindIs "map" (index .root.Values $key)) -}}
{{- fail (printf "%s must be a map with the settings of the app's container" $key) -}}
{{- end -}}
{{- if not (and (kindIs "map" .root.Values.mongodb) (kindIs "map" .root.Values.mongodb.auth)) -}}
{{- fail "mongodb and mongodb.auth must be maps with the settings of MongoDB (also for an external one: mongodb.enabled, mongodb.auth.enabled, mongodb.auth.existingSecret)" -}}
{{- end -}}
{{- end -}}

{{/*
Whether the bundled MongoDB is deployed ("true") or not (empty):
`mongodb.enabled`, true if not set.
*/}}
{{- define "foca-common.mongodbEnabled" -}}
{{- if dig "enabled" true (.Values.mongodb | default dict) -}}
true
{{- end -}}
{{- end -}}

{{/*
Number of the app's pods: `<valuesKey>.replicas`, 1 if not set; fails
unless it is a whole number of at least 1 (also for app charts with an
older schema). Call with the context dict.
*/}}
{{- define "foca-common.replicas" -}}
{{- $key := .settings.valuesKey -}}
{{- $replicas := (index .root.Values $key).replicas -}}
{{- if kindIs "invalid" $replicas -}}
1
{{- else -}}
{{- $integer := or (kindIs "int" $replicas) (kindIs "int64" $replicas) (and (kindIs "float64" $replicas) (eq $replicas (floor $replicas))) -}}
{{- if not (and $integer (ge (int $replicas) 1)) -}}
{{- fail (printf "%s.replicas must be a whole number of at least 1" $key) -}}
{{- end -}}
{{- int $replicas -}}
{{- end -}}
{{- end -}}

{{/*
A value that must be a whole number of at least 1, as such; fails otherwise
(for app charts with an older schema). Call with a dict with the `value` and
its `key`, for the message.
*/}}
{{- define "foca-common.checkPositive" -}}
{{- $integer := or (kindIs "int" .value) (kindIs "int64" .value) (and (kindIs "float64" .value) (eq .value (floor .value))) -}}
{{- if not (and $integer (ge (int .value) 1)) -}}
{{- fail (printf "%s must be a whole number of at least 1" .key) -}}
{{- end -}}
{{- int .value -}}
{{- end -}}

{{/*
`true` if `<valuesKey>.autoscaling.enabled` is, else `false`; fails unless it
is a boolean or not set, or `autoscaling` isn't a map (for app charts with an
older schema). Call with the context dict.
*/}}
{{- define "foca-common.autoscalingEnabled" -}}
{{- $key := .settings.valuesKey -}}
{{- $autoscaling := (index .root.Values $key).autoscaling -}}
{{- if not (or (kindIs "invalid" $autoscaling) (kindIs "map" $autoscaling)) -}}
{{- fail (printf "%s.autoscaling must be a map" $key) -}}
{{- end -}}
{{- $enabled := false -}}
{{- if $autoscaling -}}
{{- $enabled = $autoscaling.enabled -}}
{{- end -}}
{{- if not (or (kindIs "invalid" $enabled) (kindIs "bool" $enabled)) -}}
{{- fail (printf "%s.autoscaling.enabled must be true or false" $key) -}}
{{- end -}}
{{- if $enabled -}}
true
{{- else -}}
false
{{- end -}}
{{- end -}}

{{/*
Number of pods that the app has at least with autoscaling:
`<valuesKey>.autoscaling.minReplicas`, 2 if not set. Call with the context
dict.
*/}}
{{- define "foca-common.minReplicas" -}}
{{- $key := .settings.valuesKey -}}
{{- $min := (index .root.Values $key).autoscaling.minReplicas -}}
{{- if kindIs "invalid" $min -}}
{{- $min = 2 -}}
{{- end -}}
{{- include "foca-common.checkPositive" (dict "key" (printf "%s.autoscaling.minReplicas" $key) "value" $min) -}}
{{- end -}}

{{/*
`<valuesKey>.topologySpreadConstraints` of the app's pods, as YAML, with the
selector of the app's pods as `labelSelector` where none is given (an empty one
would mean all pods of the namespace); empty if there are none. Fails if it isn't
a list of maps with the required fields (for app charts without the schema). Call
with the context dict.
*/}}
{{- define "foca-common.topologySpreadConstraints" -}}
{{- $root := .root -}}
{{- $key := .settings.valuesKey -}}
{{- $constraints := (index $root.Values $key).topologySpreadConstraints -}}
{{- if not (or (kindIs "invalid" $constraints) (kindIs "slice" $constraints)) -}}
{{- fail (printf "%s.topologySpreadConstraints must be a list of TopologySpreadConstraint" $key) -}}
{{- end -}}
{{- $selector := include "foca-common.selectorLabels" (dict "root" $root "component" "app") | fromYaml -}}
{{- $filled := list -}}
{{- range $constraints -}}
{{- if not (and (kindIs "map" .) .maxSkew .topologyKey .whenUnsatisfiable) -}}
{{- fail (printf "%s.topologySpreadConstraints must be a list of TopologySpreadConstraint, each with maxSkew of at least 1, topologyKey and whenUnsatisfiable" $key) -}}
{{- end -}}
{{- $constraint := deepCopy . -}}
{{- $given := $constraint.labelSelector -}}
{{- if not (or (kindIs "invalid" $given) (kindIs "map" $given)) -}}
{{- fail (printf "%s.topologySpreadConstraints: labelSelector must be a map" $key) -}}
{{- end -}}
{{- if not (and $given (or $given.matchLabels $given.matchExpressions)) -}}
{{- $_ := set $constraint "labelSelector" (dict "matchLabels" $selector) -}}
{{- end -}}
{{- $filled = append $filled $constraint -}}
{{- end -}}
{{- with $filled -}}
{{- toYaml . -}}
{{- end -}}
{{- end -}}

{{/*
Whether the Celery worker is deployed ("true") or not (empty):
`worker.enabled`, false if not set (also without a `worker` map).
*/}}
{{- define "foca-common.workerEnabled" -}}
{{- if dig "enabled" false (.Values.worker | default dict) -}}
true
{{- end -}}
{{- end -}}

{{/*
Whether the bundled broker is deployed ("true") or not (empty):
`broker.enabled`, false if not set (also without a `broker` map).
*/}}
{{- define "foca-common.brokerEnabled" -}}
{{- if dig "enabled" false (.Values.broker | default dict) -}}
true
{{- end -}}
{{- end -}}

{{/*
Name of the existing Secret with the broker settings (`broker.existingSecret`),
required for the worker and the bundled broker; empty if not set otherwise.
*/}}
{{- define "foca-common.brokerSecret" -}}
{{- $secret := dig "existingSecret" "" (.Values.broker | default dict) -}}
{{- if and (not $secret) (or (include "foca-common.workerEnabled" .) (include "foca-common.brokerEnabled" .)) -}}
{{- fail "broker.existingSecret must be set if worker.enabled or broker.enabled: a Secret with the key broker-url (and username and password for the bundled broker)" -}}
{{- end -}}
{{- $secret -}}
{{- end -}}

{{/*
Environment variables of the app and the worker with the broker settings, if
`broker.existingSecret` is set: `CELERY_BROKER_URL` (key `broker-url`) and,
if the Secret has the key `result-backend`, `CELERY_RESULT_BACKEND`, which
take precedence over the `jobs` config. Call with the root context.
*/}}
{{- define "foca-common.celeryEnv" -}}
{{- with include "foca-common.brokerSecret" . }}
- name: CELERY_BROKER_URL
  valueFrom:
    secretKeyRef:
      name: {{ . | quote }}
      key: broker-url
- name: CELERY_RESULT_BACKEND
  valueFrom:
    secretKeyRef:
      name: {{ . | quote }}
      key: result-backend
      optional: true
{{- end }}
{{- end -}}

{{/*
Environment variable of the app and the worker with the key secret of the
plugin store (`plugins.defaults.store.key_secret` of FOCA), if
`pluginStore.existingSecret` is set: `FOCA_PLUGINS_STORE_KEY_SECRET` (key
`store-key-secret`, which the Secret must have). Call with the root context.
*/}}
{{- define "foca-common.pluginsEnv" -}}
{{- with dig "existingSecret" "" (.Values.pluginStore | default dict) }}
- name: FOCA_PLUGINS_STORE_KEY_SECRET
  valueFrom:
    secretKeyRef:
      name: {{ . | quote }}
      key: store-key-secret
{{- end }}
{{- end -}}

{{/*
Further environment variables of the app and the worker from
`<valuesKey>.extraEnv` (a list of EnvVar). Fails if it isn't such a list (for
app charts without the schema), sets a name twice or a variable that the chart
sets (see `foca-common.reservedEnv`), as the last one with a name would win, or
has a secret as a literal value (see `foca-common.checkExtraEnvSecret`). Call
with the context dict.
*/}}
{{- define "foca-common.extraEnv" -}}
{{- $key := .settings.valuesKey -}}
{{- $values := index .root.Values $key -}}
{{- $extraEnv := $values.extraEnv -}}
{{- if not (or (kindIs "invalid" $extraEnv) (kindIs "slice" $extraEnv)) -}}
{{- fail (printf "%s.extraEnv must be a list of EnvVar" $key) -}}
{{- end -}}
{{- $reserved := include "foca-common.reservedEnv" . | splitList " " -}}
{{- $seen := list -}}
{{- range $extraEnv -}}
{{- if not (and (kindIs "map" .) (kindIs "string" .name) .name) -}}
{{- fail (printf "%s.extraEnv must be a list of EnvVar, each with a name" $key) -}}
{{- end -}}
{{- if has .name $reserved -}}
{{- fail (printf "%s.extraEnv must not set %s, which the chart sets" $key .name) -}}
{{- end -}}
{{- if has .name $seen -}}
{{- fail (printf "%s.extraEnv must not set %s twice" $key .name) -}}
{{- end -}}
{{- $seen = append $seen .name -}}
{{- include "foca-common.checkExtraEnvSecret" (dict "key" $key "var" .) -}}
{{- end -}}
{{- with $extraEnv -}}
{{- toYaml . -}}
{{- end -}}
{{- end -}}

{{/*
Refuse secrets as literal values in `<valuesKey>.extraEnv`, which would be
readable in the Deployment, like `foca-common.checkStoreKeySecret` for the
overlay: variables that hold only a secret, and connection strings with
credentials (with an `@`). Use `valueFrom` for them. The value is not shown.
Call with a dict of the values key (`key`) and the EnvVar (`var`).
*/}}
{{- define "foca-common.checkExtraEnvSecret" -}}
{{- $value := toString (get .var "value" | default "") -}}
{{- $secret := and $value (has .var.name (list "MONGO_PASSWORD" "FOCA_PLUGINS_STORE_KEY_SECRET")) -}}
{{- $credentials := and (contains "@" $value) (has .var.name (list "MONGO_URI" "CELERY_BROKER_URL" "CELERY_RESULT_BACKEND")) -}}
{{- if or $secret $credentials -}}
{{- fail (printf "%s.extraEnv must take %s from a Secret (valueFrom), not as a literal value" .key .var.name) -}}
{{- end -}}
{{- end -}}

{{/*
Sources of environment variables of the app and the worker from
`<valuesKey>.extraEnvFrom` (a list of EnvFromSource). Fails if it isn't such a
list (for app charts without the schema). Call with the context dict.
*/}}
{{- define "foca-common.extraEnvFrom" -}}
{{- $key := .settings.valuesKey -}}
{{- $extraEnvFrom := (index .root.Values $key).extraEnvFrom -}}
{{- if not (or (kindIs "invalid" $extraEnvFrom) (kindIs "slice" $extraEnvFrom)) -}}
{{- fail (printf "%s.extraEnvFrom must be a list of EnvFromSource" $key) -}}
{{- end -}}
{{- range $extraEnvFrom -}}
{{- if not (kindIs "map" .) -}}
{{- fail (printf "%s.extraEnvFrom must be a list of EnvFromSource" $key) -}}
{{- end -}}
{{- end -}}
{{- with $extraEnvFrom -}}
{{- toYaml . -}}
{{- end -}}
{{- end -}}

{{/*
Names of the environment variables that the chart sets for the app or the
worker, separated by spaces. Call with the context dict.
*/}}
{{- define "foca-common.reservedEnv" -}}
{{- $root := .root -}}
{{- $names := list "FOCA_CONFIG_OVERLAY" "PORT" -}}
{{- if (index $root.Values .settings.valuesKey).gunicorn -}}
{{- $names = append $names "GUNICORN_CMD_ARGS" -}}
{{- end -}}
{{- if $root.Values.mongodb.auth.enabled -}}
{{- $names = concat $names (list "MONGO_USERNAME" "MONGO_PASSWORD") -}}
{{- end -}}
{{- if $root.Values.broker | default dict | dig "existingSecret" "" -}}
{{- $names = concat $names (list "CELERY_BROKER_URL" "CELERY_RESULT_BACKEND") -}}
{{- end -}}
{{- if include "foca-common.pluginsEnv" $root | trim -}}
{{- $names = append $names "FOCA_PLUGINS_STORE_KEY_SECRET" -}}
{{- end -}}
{{- join " " $names -}}
{{- end -}}

{{/*
Checksum of the data of the Secrets in `<valuesKey>.rolloutOnSecrets`, for an
annotation that rolls the pods when they change; empty if none of them is
found. `lookup` finds nothing in `helm template` and in Argo CD, as they don't
read from a cluster. Call with the context dict.
*/}}
{{- define "foca-common.rolloutChecksum" -}}
{{- $root := .root -}}
{{- $key := .settings.valuesKey -}}
{{- $names := (index $root.Values $key).rolloutOnSecrets -}}
{{- if not (or (kindIs "invalid" $names) (kindIs "slice" $names)) -}}
{{- fail (printf "%s.rolloutOnSecrets must be a list of names of Secrets" $key) -}}
{{- end -}}
{{- $data := dict -}}
{{- range $names -}}
{{- if not (and (kindIs "string" .) .) -}}
{{- fail (printf "%s.rolloutOnSecrets must be a list of names of Secrets" $key) -}}
{{- end -}}
{{- $secret := lookup "v1" "Secret" $root.Release.Namespace . -}}
{{- if $secret -}}
{{- $_ := set $data . $secret.data -}}
{{- end -}}
{{- end -}}
{{- if $data -}}
{{- toJson $data | sha256sum -}}
{{- end -}}
{{- end -}}

{{/*
Refuse to render the key secret of the plugin store
(`plugins.defaults.store.key_secret`) into the config overlay, a ConfigMap;
an empty or null one passes (FOCA then reads `FOCA_PLUGINS_STORE_KEY_SECRET`),
any other value fails. The secret's value is not shown. The levels are
walked by hand, as `dig` fails if one is null or no map. Call with a dict of
the overlay (`config`; see `foca-common.configOverlay`).
*/}}
{{- define "foca-common.checkStoreKeySecret" -}}
{{- $store := dict -}}
{{- $plugins := get .config "plugins" -}}
{{- if kindIs "map" $plugins -}}
{{- $defaults := get $plugins "defaults" -}}
{{- if and (kindIs "map" $defaults) (kindIs "map" (get $defaults "store")) -}}
{{- $store = get $defaults "store" -}}
{{- end -}}
{{- end -}}
{{- $secret := get $store "key_secret" -}}
{{- if not (or (kindIs "invalid" $secret) (and (kindIs "string" $secret) (eq $secret ""))) -}}
{{- fail "config.plugins.defaults.store.key_secret must not be set, as the config overlay is a ConfigMap: put the secret in the key store-key-secret of an existing Secret and set pluginStore.existingSecret to its name" -}}
{{- end -}}
{{- end -}}

{{/*
Whether an OpenShift Route is created ("true") or not (empty): unless
`<valuesKey>.route.enabled` is false (it is true if not set, as in values
written for foca-common 0.1.0), without an Ingress or HTTPRoute, if the
cluster serves Routes.
*/}}
{{- define "foca-common.routeEnabled" -}}
{{- $values := index .root.Values .settings.valuesKey -}}
{{- $exposed := or (dig "ingress" "enabled" false $values) (dig "httpRoute" "enabled" false $values) -}}
{{- $enabled := dig "route" "enabled" true $values -}}
{{- if and $enabled (not $exposed) (.root.Capabilities.APIVersions.Has "route.openshift.io/v1") -}}
true
{{- end -}}
{{- end -}}

{{/*
Checks of the values and the release; renders nothing. Included by the
ConfigMap template, which every app chart renders.
*/}}
{{- define "foca-common.validate" -}}
{{- include "foca-common.checkSettings" . -}}
{{- $fullname := include "foca-common.fullname" .root -}}
{{- if and (include "foca-common.mongodbEnabled" .root) (eq $fullname (include "foca-common.mongodbFullname" .root)) -}}
{{- fail (printf "the app and MongoDB resources would both be named %s: choose a fullnameOverride that does not end in -mongodb" $fullname) -}}
{{- end -}}
{{- if and (include "foca-common.workerEnabled" .root) (eq $fullname (include "foca-common.workerFullname" .root)) -}}
{{- fail (printf "the app and worker resources would both be named %s: choose a fullnameOverride that does not end in -worker" $fullname) -}}
{{- end -}}
{{- if and (include "foca-common.brokerEnabled" .root) (eq $fullname (include "foca-common.brokerFullname" .root)) -}}
{{- fail (printf "the app and broker resources would both be named %s: choose a fullnameOverride that does not end in -broker" $fullname) -}}
{{- end -}}
{{- $values := index .root.Values .settings.valuesKey -}}
{{- $key := .settings.valuesKey -}}
{{- $httpRoute := dig "httpRoute" "enabled" false $values -}}
{{- if and $httpRoute (dig "ingress" "enabled" false $values) -}}
{{- fail (printf "%s.ingress.enabled and %s.httpRoute.enabled are mutually exclusive: set %s.ingress.enabled to false to expose the app via a Gateway" $key $key $key) -}}
{{- end -}}
{{- if and $httpRoute (dig "httpRoute" "httpsRedirect" "enabled" false $values) (eq $fullname (include "foca-common.httpsRedirectFullname" .root)) -}}
{{- fail (printf "the app's HTTPRoute and the HTTPS redirect would both be named %s: choose a fullnameOverride that does not end in -https-redirect" $fullname) -}}
{{- end -}}
{{- if .settings.plugins -}}
{{- include "foca-common.checkPluginValues" .root -}}
{{- end -}}
{{- with .settings.backendsKey -}}
{{- include "foca-common.checkBackends" (dict "root" $.root "settings" $.settings "key" .) -}}
{{- end -}}
{{- if .settings.requireAccessControl -}}
{{- include "foca-common.checkAccessControl" .root -}}
{{- end -}}
{{- $_ := include "foca-common.brokerSecret" .root -}}
{{- $_ = include "foca-common.maxContentLength" . -}}
{{- $config := include "foca-common.configOverlay" . | fromYaml -}}
{{- if not (include "foca-common.mongodbEnabled" .root) -}}
{{- $db := get $config "db" -}}
{{- $host := and (kindIs "map" $db) (get $db "host") -}}
{{- if not (and (kindIs "string" $host) (trim $host)) -}}
{{- fail "config.db.host must be set to the host of the external MongoDB if mongodb.enabled is false" -}}
{{- end -}}
{{- end -}}
{{- if .settings.requireAudience -}}
{{- include "foca-common.checkAudience" (dict "config" $config) -}}
{{- end -}}
{{- include "foca-common.checkStoreKeySecret" (dict "config" $config) -}}
{{- end -}}

{{/*
"true" if a value is an audience setting that FOCA accepts: a non-empty list
of non-blank client IDs; otherwise empty.
*/}}
{{- define "foca-common.isAudience" -}}
{{- $valid := and (kindIs "slice" .) (gt (len .) 0) -}}
{{- range $client := (ternary . (list) $valid) -}}
{{- if not (and (kindIs "string" $client) (trim $client)) -}}
{{- $valid = false -}}
{{- end -}}
{{- end -}}
{{- if $valid -}}true{{- end -}}
{{- end -}}

{{/*
As FOCA on startup, refuse to render without an audience (a list of
non-blank client IDs) for the trusted token issuers, unless audience
validation is explicitly disabled: with a value that pydantic parses as false
(e.g., `false` or "False"; the strings are those of pydantic 2.14,
pydantic-core 2.50). `null` doesn't disable it (FOCA refuses it). Each issuer
of `security.auth.issuers` needs an audience of its own or the global one, so
the global one is optional if all issuers have their own; without `issuers`
it is required, as the app's base config may list them, but an empty list
removes them. Audiences that are set must be valid, also if no issuer uses
them. Only the
overlay is checked, so the app's settings opt in (`requireAudience`) if the
app needs token issuers. Call with a dict of the overlay (`config`; see
`foca-common.configOverlay`).
*/}}
{{- define "foca-common.checkAudience" -}}
{{- $auth := dict -}}
{{- $security := get .config "security" -}}
{{- if and (kindIs "map" $security) (kindIs "map" (get $security "auth")) -}}
{{- $auth = get $security "auth" -}}
{{- end -}}
{{- $verifyAudience := true -}}
{{- if hasKey $auth "verify_audience" -}}
{{- $verifyAudience = get $auth "verify_audience" -}}
{{- end -}}
{{- if kindIs "invalid" $verifyAudience -}}
{{- $verifyAudience = true -}}
{{- else if kindIs "string" $verifyAudience -}}
{{- $verifyAudience = not (has (lower $verifyAudience) (list "0" "off" "f" "false" "n" "no")) -}}
{{- end -}}
{{- /* `index`, as `get` gives an empty string for missing keys */ -}}
{{- $audience := index $auth "audience" -}}
{{- $hasAudience := include "foca-common.isAudience" $audience -}}
{{- /* Unset or empty: fine if all issuers have audiences of their own */ -}}
{{- $unset := or (kindIs "invalid" $audience) (and (kindIs "slice" $audience) (not $audience)) -}}
{{- $valid := or $hasAudience $unset -}}
{{- $issuers := index $auth "issuers" -}}
{{- /* An empty list removes the issuers of the base config */ -}}
{{- $needsGlobal := not (kindIs "slice" $issuers) -}}
{{- $issuers = ternary $issuers (list) (kindIs "slice" $issuers) -}}
{{- range $issuer := $issuers -}}
{{- /* Plain URLs have no settings of their own */ -}}
{{- $own := index (ternary $issuer (dict) (kindIs "map" $issuer)) "audience" -}}
{{- if kindIs "invalid" $own -}}
{{- $needsGlobal = true -}}
{{- else if not (include "foca-common.isAudience" $own) -}}
{{- /* FOCA refuses these whatever verify_audience says */ -}}
{{- fail "the audience of each of config.security.auth.issuers must list non-blank client IDs, if set" -}}
{{- end -}}
{{- end -}}
{{- if and $verifyAudience (or (not $valid) (and $needsGlobal (not $hasAudience))) -}}
{{- fail "config.security.auth.audience must list the client IDs of the apps calling this app (e.g., its front end), whose tokens are accepted, unless each of config.security.auth.issuers has an audience of its own; or set config.security.auth.verify_audience to false to accept tokens for any audience (not recommended)" -}}
{{- end -}}
{{- end -}}

{{/*
Security context from the values; call with a dict of the root context
(`root`) and the context (`context`). On OpenShift, which assigns user and
group IDs from the namespace's range (and rejects others under the default
security context constraints), these IDs are omitted.
*/}}
{{- define "foca-common.securityContext" -}}
{{- $context := .context | default dict -}}
{{- if .root.Capabilities.APIVersions.Has "security.openshift.io/v1" -}}
{{- $context = omit $context "runAsUser" "runAsGroup" "fsGroup" -}}
{{- end -}}
{{- toYaml $context -}}
{{- end -}}

{{/*
Name of the existing Secret with the MongoDB credentials.
*/}}
{{- define "foca-common.mongodbSecret" -}}
{{- required "mongodb.auth.existingSecret must be set if mongodb.auth.enabled; for existing databases without authentication, create the users first" .Values.mongodb.auth.existingSecret -}}
{{- end -}}

{{/*
Environment variables taken from keys of the Secret with the MongoDB
credentials; call with a dict of the root context (`root`) and a dict mapping
variable names to Secret keys (`vars`); variables are rendered in
alphabetical order.
*/}}
{{- define "foca-common.mongodbSecretEnv" -}}
{{- $secret := include "foca-common.mongodbSecret" .root -}}
{{- range $name, $key := .vars }}
- name: {{ $name }}
  valueFrom:
    secretKeyRef:
      name: {{ $secret | quote }}
      key: {{ $key }}
{{- end }}
{{- end -}}

{{/*
App image: `<valuesKey>.image` with `<valuesKey>.tag`, by default the chart's
`appVersion`; an image with a tag or digest is used as it is.
*/}}
{{- define "foca-common.image" -}}
{{- $key := .settings.valuesKey -}}
{{- $values := index .root.Values $key -}}
{{- $image := required (printf "%s.image must be set" $key) $values.image -}}
{{- $tag := $values.tag -}}
{{- if or (contains "@" $image) (regexMatch ":[^/]+$" $image) -}}
{{- if $tag -}}
{{- fail (printf "%s.tag must not be set if %s.image includes a tag or digest" $key $key) -}}
{{- end -}}
{{- $image -}}
{{- else -}}
{{- printf "%s:%s" $image ($tag | default .root.Chart.AppVersion) -}}
{{- end -}}
{{- end -}}

{{/*
Size limit of request bodies of the app, in bytes: `server.max_content_length`
of the overlay (see `foca-common.configOverlay`), by default that of the
app's settings (`maxContentLength`); empty if neither sets one. The library's
resources don't use it, but app charts may, e.g., for a size limit at the
proxy in resources of their own. Fails unless it is a positive integer, as
FOCA requires (numbers from values files are floats).
*/}}
{{- define "foca-common.maxContentLength" -}}
{{- $server := get (include "foca-common.configOverlay" . | fromYaml) "server" -}}
{{- if not (kindIs "map" $server) -}}
{{- $server = dict -}}
{{- end -}}
{{- $limit := .settings.maxContentLength -}}
{{- if hasKey $server "max_content_length" -}}
{{- $limit = index $server "max_content_length" -}}
{{- end -}}
{{- if not (kindIs "invalid" $limit) -}}
{{- $integer := or (kindIs "int" $limit) (kindIs "int64" $limit) (and (kindIs "float64" $limit) (eq $limit (floor $limit))) -}}
{{- if not (and $integer (ge (int64 $limit) 1)) -}}
{{- fail (printf "config.server.max_content_length must be a positive integer (bytes), not %v" $limit) -}}
{{- end -}}
{{- int64 $limit -}}
{{- end -}}
{{- end -}}

{{/*
`emptyDir` volume source with an optional size limit (a quantity string or a
number of bytes; numbers from values files are floats, so they are rendered
as integers); none if `null`.
*/}}
{{- define "foca-common.emptyDir" -}}
{{- if kindIs "invalid" . -}}
emptyDir: {}
{{- else -}}
emptyDir:
  sizeLimit: {{ ternary . (int64 . | toString) (kindIs "string" .) | quote }}
{{- end -}}
{{- end -}}

{{/*
Name of the PersistentVolumeClaim with a component's data (MongoDB's or the
broker's) if its persistence is enabled (`persistence.enabled`, or
`enabledByDefault` if that is not set, also without a `persistence` map):
`persistence.existingClaim`, or the component's own claim (`name`); empty
otherwise. Call with a dict of the component's `persistence` map, its claim's
`name`, `enabledByDefault` and the values key of the map (`key`, e.g.,
`mongodb.persistence`, for error messages of
`foca-common.persistentVolumeClaim`).
*/}}
{{- define "foca-common.claimName" -}}
{{- $persistence := .persistence | default dict -}}
{{- if dig "enabled" .enabledByDefault $persistence -}}
{{- $persistence.existingClaim | default .name -}}
{{- end -}}
{{- end -}}

{{/*
PersistentVolumeClaim with a component's data, if its persistence is enabled
without `persistence.existingClaim` (see `foca-common.claimName`): of `size`
(`persistence.size` if not given; fails if neither is set),
with `persistence.accessModes` (by default `ReadWriteOnce`) and
`persistence.storageClass` (the cluster's default class if empty; "-" for
none, i.e., no dynamic provisioning), annotated with
`helm.sh/resource-policy: keep` if `persistence.resourcePolicy` is `keep`
(`resourcePolicyByDefault` if that is not set), so that Helm keeps the claim
when the release is uninstalled (or the claim is removed from it). Call with
a dict of the root context (`root`), the `component` (for the labels), the
arguments of `foca-common.claimName`, `size` and `resourcePolicyByDefault`.
*/}}
{{- define "foca-common.persistentVolumeClaim" -}}
{{- $persistence := .persistence | default dict -}}
{{- if and (include "foca-common.claimName" .) (not $persistence.existingClaim) -}}
{{- $resourcePolicy := ternary (get $persistence "resourcePolicy") .resourcePolicyByDefault (hasKey $persistence "resourcePolicy") -}}
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ .name | quote }}
  labels:
    {{- include "foca-common.labels" (dict "root" .root "component" .component) | nindent 4 }}
  {{- if eq (toString $resourcePolicy) "keep" }}
  annotations:
    helm.sh/resource-policy: keep
  {{- end }}
spec:
  accessModes:
    {{- toYaml ($persistence.accessModes | default (list "ReadWriteOnce")) | nindent 2 }}
  resources:
    requests:
      storage: {{ required (printf "%s.size must be set if %s.enabled" .key .key) (.size | default $persistence.size) }}
  {{- with $persistence.storageClass }}
  storageClassName: {{ ternary "" . (eq . "-") | quote }}
  {{- end }}
{{ end -}}
{{- end -}}

{{/*
Gunicorn options (`GUNICORN_CMD_ARGS`) from `<valuesKey>.gunicorn`: the
numbers (floats from values files) as integers, followed by `extraArgs`, each
in single quotes, as Gunicorn splits the options like shell words (the schema
rejects single quotes in them).
*/}}
{{- define "foca-common.gunicornArgs" -}}
{{- $key := .settings.valuesKey -}}
{{- $g := (index .root.Values $key).gunicorn -}}
{{- $args := list
  "--workers" (int $g.workers)
  "--threads" (int $g.threads)
  "--timeout" (int $g.timeout)
  "--graceful-timeout" (int $g.gracefulTimeout)
  "--keep-alive" (int $g.keepalive)
-}}
{{- range $g.extraArgs -}}
{{- include "foca-common.checkGunicornArg" (dict "key" $key "arg" .) -}}
{{- $args = append $args (squote .) -}}
{{- end -}}
{{- join " " $args -}}
{{- end -}}

{{/*
Fails if an item of `<valuesKey>.gunicorn.extraArgs` sets an option that the
chart or FOCA relies on: `--bind`/`-b` (the chart's ports), `--preload`
(MongoDB clients must be created after forking) or `--graceful-timeout` (the
termination grace period is derived from `gracefulTimeout`). As Gunicorn
parses them: long options also abbreviated and with `=value`; `-b` also with
an attached value and after the short flags `-D` and `-R`. Items like
`--bind x` (a space before any `=`) are values for Gunicorn, not options, so
they pass. Call with a dict of the values key (`key`) and the item (`arg`).
*/}}
{{- define "foca-common.checkGunicornArg" -}}
{{- $arg := .arg -}}
{{- $name := lower (regexReplaceAll "=.*$" $arg "") -}}
{{- $reserved := false -}}
{{- if hasPrefix "--" $name -}}
{{- range list "--bind" "--preload" "--graceful-timeout" -}}
{{- if and (ge (len $name) 3) (hasPrefix $name .) -}}
{{- $reserved = true -}}
{{- end -}}
{{- end -}}
{{- else if regexMatch "^-[DR]*b" $arg -}}
{{- $reserved = true -}}
{{- end -}}
{{- if $reserved -}}
{{- fail (printf "%s.gunicorn.extraArgs must not set --bind/-b (the chart's ports are 8080), --preload (MongoDB clients must be created after forking) or --graceful-timeout (set gracefulTimeout instead): %s" .key $arg) -}}
{{- end -}}
{{- end -}}

{{/*
Termination grace period of the app's pod, in seconds: the `preStop` delay,
then Gunicorn's graceful timeout for finishing requests, plus a margin for
Gunicorn to stop its workers and exit before it is killed; without Gunicorn
settings, the `preStop` delay plus Kubernetes' default of 30 seconds.
*/}}
{{- define "foca-common.terminationGracePeriod" -}}
{{- $values := index .root.Values .settings.valuesKey -}}
{{- $preStop := int ($values.preStopSleepSeconds | default 0) -}}
{{- if $values.gunicorn -}}
{{- $margin := 10 -}}
{{- add $preStop (int $values.gunicorn.gracefulTimeout) $margin -}}
{{- else -}}
{{- add $preStop 30 -}}
{{- end -}}
{{- end -}}
